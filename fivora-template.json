{
  "framework": "nextjs-static-export",
  "version": 2,
  "visualEditing": {
    "contractVersion": 1,
    "mode": "strict",
    "controlOnlyPaths": [
      "products[*].id",
      "products[*].isAvailable",
      "services[*].id",
      "products[*].currency",
      "about.collageImages[*].id",
      "common.navLabels.about_us",
      "ourStory.imageAlt",
      "contact.whatsapp",
      "contact.lifestyleImageAlt",
      "home.categories[*].id",
      "home.heroImageAlt",
      "home.storyImageAlt",
      "home.newsletterPreviewMessage",
      "home.cartTitle",
      "home.cartDescription",
      "home.cartCloseLabel",
      "services[*].showPrice",
      "products[*].details",
      "products[*].originalPrice",
      "products[*].compareAtPrice",
      "products[*].category",
      "products[*].description",
      "products[*].ctaLabel",
      "navigation.dropdownBackgroundColor",
      "navigation.categories[*].id",
      "navigation.categories[*].items[*].id",
      "navigation.searchLabel",
      "navigation.wishlistLabel",
      "navigation.cartLabel",
      "navigation.searchTitle",
      "navigation.searchPlaceholder",
      "navigation.searchEmpty",
      "navigation.searchDescription",
      "navigation.searchRoomsTitle",
      "navigation.searchSuggestionsTitle",
      "navigation.searchResultsTitle",
      "navigation.searchEmptyTitle",
      "navigation.searchResetLabel",
      "navigation.wishlistTitle",
      "navigation.wishlistDescription",
      "products[*].homeCollection",
      "home.look.imageAlt",
      "home.look.emptyMessage",
      "home.look.hotspots[*].id",
      "home.look.hotspots[*].productId",
      "home.look.hotspots[*].x",
      "home.look.hotspots[*].y",
      "announcements.enabled"
    ]
  },
  "siteDataFile": "src/data/site-data.json",
  "outputDirectory": "out",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "basePathEnvVar": "NEXT_PUBLIC_SITE_BASE_PATH",
  "pages": [
    {
      "id": "home",
      "label": "Home",
      "route": "/",
      "required": true
    },
    {
      "id": "about_us",
      "label": "About Us",
      "route": "/about_us"
    },
    {
      "id": "about",
      "label": "Our Story",
      "route": "/about"
    },
    {
      "id": "services",
      "label": "Services",
      "route": "/services"
    },
    {
      "id": "contact",
      "label": "Contact",
      "route": "/contact"
    },
    {
      "id": "living_room",
      "label": "Living Room",
      "route": "/collections/living-room"
    },
    {
      "id": "bedroom",
      "label": "Bedroom",
      "route": "/collections/bedroom"
    },
    {
      "id": "kitchen_dining",
      "label": "Kitchen & Dining",
      "route": "/collections/kitchen-dining"
    },
    {
      "id": "office",
      "label": "Office Furniture",
      "route": "/collections/office"
    },
    {
      "id": "lighting_decor",
      "label": "Lighting & Decor",
      "route": "/collections/lighting-decor"
    },
    {
      "id": "sale",
      "label": "Sale",
      "route": "/collections/sale"
    },
    {
      "id": "product_detail",
      "label": "Product Details",
      "route": "/products/detail",
      "required": true
    },
    {
      "id": "cart",
      "label": "Cart",
      "route": "/cart",
      "required": true
    },
    {
      "id": "wishlist",
      "label": "Wishlist",
      "route": "/wishlist",
      "required": true
    }
  ],
  "editorSchema": {
    "version": 1,
    "sections": [
      {
        "id": "our-story",
        "path": "ourStory",
        "pageKey": "about",
        "type": "object",
        "label": "Our Story page",
        "fields": [
          { "key": "eyebrow", "type": "text", "label": "Hero eyebrow" },
          { "key": "heading", "type": "text", "label": "Hero heading" },
          { "key": "tagline", "type": "textarea", "label": "Hero tagline" },
          { "key": "imageUrl", "type": "image", "label": "Lifestyle hero image" },
          { "key": "imageAlt", "type": "text", "label": "Hero image description" },
          { "key": "storyHeading", "type": "text", "label": "Story heading" },
          { "key": "body", "type": "textarea", "label": "Brand introduction" },
          {
            "key": "values",
            "type": "list",
            "label": "Brand values",
            "minItems": 0,
            "maxItems": 3,
            "fields": [
              { "key": "title", "type": "text", "label": "Value heading" },
              { "key": "description", "type": "textarea", "label": "Value description" }
            ]
          },
          { "key": "ctaHeading", "type": "text", "label": "Collection invitation heading" },
          { "key": "ctaLabel", "type": "text", "label": "Explore collections button label" },
          { "key": "ctaUrl", "type": "text", "label": "Explore collections link" }
        ]
      },
