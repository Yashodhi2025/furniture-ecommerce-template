  "themeSchema": {
    "version": 1,
    "tokens": [
      "colors.primary",
      "colors.secondary",
      "colors.accent",
      "colors.background",
      "colors.text",
      "typography.headingFont",
      "typography.bodyFont",
      "typography.baseSize",
      "spacing.heroMinHeight",
      "spacing.sectionPadding"
    ],
    "defaults": {
      "colors": {
        "primary": "#5b493c",
        "secondary": "#eee7dd",
        "accent": "#a57450",
        "background": "#fbf9f5",
        "text": "#30271f"
